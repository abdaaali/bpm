{
  "name": "@bpm/integration-hub",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0", "@nestjs/core": "^10.3.0", "@nestjs/platform-express": "^10.3.0",
    "@nestjs/config": "^3.2.0", "@nestjs/swagger": "^7.3.0", "@nestjs/schedule": "^4.0.0",
    "kafkajs": "^2.2.4", "axios": "^1.6.7", "pg": "^8.11.3",
    "node-cron": "^3.0.3", "reflect-metadata": "^0.2.1", "rxjs": "^7.8.1",
    "class-validator": "^0.14.1", "class-transformer": "^0.5.1",
    "prom-client": "^15.1.0", "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0", "@types/pg": "^8.11.0", "@types/node-cron": "^3.0.11",
    "typescript": "^5.3.3", "ts-node": "^10.9.2",
    "jest": "^29.7.0", "@types/jest": "^29.5.12", "ts-jest": "^29.1.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "testMatch": ["**/__tests__/**/*.spec.ts"],
    "moduleNameMapper": { "^axios$": "<rootDir>/src/alarm/__tests__/__mocks__/axios.ts" },
    "globals": { "ts-jest": { "tsconfig": "tsconfig.json" } }
  }
}
