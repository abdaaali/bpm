# ── BPM Platform secrets template — copy to `.env` and set real values ───────
# `.env` is gitignored. For PRODUCTION use strong, unique values and rotate
# regularly. Stateful secrets (DB/Keycloak/MinIO/Grafana) take effect on a FRESH
# volume; to change them on an existing deploy, follow the rotation notes.

# Postgres role password. Rotate: `ALTER USER bpm WITH PASSWORD '...';` then update here.
POSTGRES_PASSWORD=change-me-strong
# Keycloak bootstrap admin (only sets the admin on first start; later, change in the Keycloak console).
KEYCLOAK_ADMIN_PASSWORD=change-me-strong
# Backend↔Keycloak confidential client secret (must match the Keycloak client config).
KEYCLOAK_CLIENT_SECRET=change-me-strong
# MinIO root creds (env-driven each start; used by services for attachments).
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me-strong
# PRODUCTION REQUIRED: without these, presigned attachment-download links are
# signed for the Docker-internal `minio` hostname and won't work for real
# browsers outside the Docker network. Set to the public domain(s) that front
# MinIO — see infra/edge/nginx.conf's /bpm-attachments/ location (added to
# forward these). Leave unset for local dev (falls back to the internal
# MINIO_ENDPOINT/PORT/USE_SSL above).
# case-service (frontend-portal, behind the shared edge proxy):
MINIO_PUBLIC_ENDPOINT=bpm.example.com
MINIO_PUBLIC_PORT=443
MINIO_PUBLIC_USE_SSL=true
# external-api (contractor-portal, has its own nginx, NOT behind the shared
# edge — see apps/contractor-portal/nginx.conf's matching location):
EXTERNAL_MINIO_PUBLIC_ENDPOINT=contractors.example.com
EXTERNAL_MINIO_PUBLIC_PORT=443
EXTERNAL_MINIO_PUBLIC_USE_SSL=true
# Grafana bootstrap admin (first start only).
GRAFANA_ADMIN_PASSWORD=change-me-strong
# External (contractor portal) API JWT signing secret. Rotating logs out contractor sessions.
JWT_SECRET=generate-with-openssl-rand-hex-32

# Alarm webhook tokens — set on the monitoring side too (X-Webhook-Token header). Stateless.
ZABBIX_WEBHOOK_TOKEN=generate-with-openssl-rand-hex-24
ALERTMANAGER_WEBHOOK_TOKEN=generate-with-openssl-rand-hex-24
GRAFANA_WEBHOOK_TOKEN=generate-with-openssl-rand-hex-24
MDM_API_KEY=

# ── SMTP (email) — Alertmanager ops alerts + application user notifications ──
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false            # true for port 465 (implicit TLS)
SMTP_USER=bpm@yourdomain.com
SMTP_PASSWORD=change-me
SMTP_FROM=bpm@yourdomain.com
ALERTS_EMAIL_TO=noc@yourdomain.com   # where Alertmanager sends ops alerts

# ── Edge / network hardening (production) ──
# Bind app + ops ports to loopback so only the TLS edge proxy is publicly
# reachable. Leave unset (0.0.0.0) for local dev.
BIND_ADDR=127.0.0.1
# Host ports for the edge proxy (docker-compose.edge.yml). Defaults 80/443;
# override if the deployment target needs a non-standard port, e.g. 8093.
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
# CORS allowlist for the API gateway + internal services (comma-separated, your real domain).
# Include the edge port if non-standard, e.g. https://bpm.example.com:8093
CORS_ORIGINS=https://bpm.example.com
# CORS allowlist for the external (contractor) API.
ALLOWED_ORIGINS=https://contractors.example.com

# ── Data seeding ──
# Demo data (demo users, sample cases/alarms/contractors) loads ONLY when true.
# PRODUCTION: keep false to ship a clean DB. Local dev: set true.
LOAD_DEMO_SEEDS=false
# PRODUCTION REQUIRED: set to "production" (already done in docker-compose.prod.yml's
# postgres service) to load migrations/ + seeds-production/ only, never the
# demo-flavored seeds/ or seeds-demo/. See infra/db/init.sh and
# infra/db/seeds-production/. Only takes effect on first boot against an empty
# Postgres data volume. Leave unset for local dev.
APP_ENV=

# ── Keycloak (production realm + store) ──
# Public auth hostname (behind the edge) and the frontend origin used for the
# realm redirect URIs (replaces the old wildcard). REQUIRED: after setting
# these (and KEYCLOAK_CLIENT_SECRET above), run ./keycloak/render-realm.sh
# before `docker compose up` — Keycloak's own --import-realm does NOT
# substitute ${VAR} placeholders itself, so this repo renders
# realm-export.json.template into realm-export.json locally first. Re-run it
# any time either value changes. KC_FRONTEND_URL/VITE_KEYCLOAK_URL should
# be the SAME origin the browser loads the app from (edge proxies /realms/ etc
# to Keycloak at that origin — same-origin auth, no separate Keycloak host/port).
# Include the edge port if non-standard, e.g. https://bpm.example.com:8093
KC_HOSTNAME=bpm.example.com
KC_FRONTEND_URL=https://bpm.example.com
KC_HOSTNAME_PORT=443
# Keycloak Postgres store (prod overlay). Create this DB before first start.
KC_DB_NAME=keycloak
KC_DB_USERNAME=bpm

# ── Ops tools served at /prometheus/ and /grafana/ via the edge proxy ──
PROMETHEUS_EXTERNAL_URL=https://bpm.example.com/prometheus/
GF_SERVER_ROOT_URL=https://bpm.example.com/grafana/

# ── Frontend build-time URLs (same origin as KC_FRONTEND_URL above — the edge
# proxy serves the app, API, and Keycloak from this one origin) ──
VITE_API_URL=https://bpm.example.com
VITE_KEYCLOAK_URL=https://bpm.example.com
