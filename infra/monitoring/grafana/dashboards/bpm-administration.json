      "title": "Cases by status (live)",
      "datasource": {
        "type": "postgres",
        "uid": "bpmpg"
      },
      "targets": [
        {
          "rawSql": "SELECT status, count(*) AS n FROM cases GROUP BY status ORDER BY n DESC",
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "bpmpg"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 9
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": true
        },
        "pieType": "donut"
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Largest tables",
      "datasource": {
        "type": "postgres",
        "uid": "bpmpg"
      },
      "targets": [
        {
          "rawSql": "SELECT c.relname AS table, pg_total_relation_size(c.oid) AS bytes FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relkind='r' ORDER BY bytes DESC LIMIT 12",
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "bpmpg"
          }
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 16,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "bytes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
