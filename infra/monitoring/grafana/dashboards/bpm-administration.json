        "uid": "bpmpg"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS n FROM process_instances pi WHERE pi.status IN ('completed','terminated') AND COALESCE(pi.completed_at, pi.updated_at) < now() - interval '120 days' AND NOT EXISTS (SELECT 1 FROM cases c WHERE c.process_instance_id = pi.id)",
          "format": "table",
          "rawQuery": true,
          "refId": "A",
